#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

grep -Fx 'go 1.26.0' go.mod >/dev/null
grep -Fx 'toolchain go1.27.0' go.mod >/dev/null
grep -F 'github.com/containernetworking/cni v1.3.0' go.mod >/dev/null
grep -F 'github.com/vishvananda/netns v0.0.5' go.mod >/dev/null
grep -F 'golang.org/x/sys v0.47.0' go.mod >/dev/null

grep -F 'metadataCARootPath      = metadataCARootDirectory + "/" + metadataCARootName' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'metadataCARootDirectory = "/var/lib/pasturestack/etc/ssl"' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'transport.Proxy = nil' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'return http.ErrUseLastResponse' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'root, err := os.OpenRoot(metadataCARootDirectory)' ipfinder/metadata/ip_finder_metadata.go >/dev/null
grep -F 'root, err := os.OpenRoot(rootPath)' main.go >/dev/null

if grep -n -E \
    'os\.ReadFile\(caRootPath\)|os\.OpenFile\(config\.LogToFile|ProxyFromEnvironment' \
    main.go ipfinder/metadata/ip_finder_metadata.go; then
    echo 'unsafe privileged filesystem or proxy flow returned to the source tree' >&2
    exit 1
fi
